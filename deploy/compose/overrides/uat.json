{
  "services": {
    "ugnay": {
      "env_file": [
        "${HAXUS_SERVICE_ENV_ROOT}/ugnay.env"
      ],
      "ports": [
        "127.0.0.1:${UGNAY_PORT:-5191}:8080"
      ]
    },
    "application-db": {
      "env_file": [
        "${HAXUS_SERVICE_ENV_ROOT}/application-db.env"
      ]
    },
    "support-db": {
      "env_file": [
        "${HAXUS_SERVICE_ENV_ROOT}/support-db.env"
      ]
    },
    "keycloak": {
      "env_file": [
        "${HAXUS_SERVICE_ENV_ROOT}/keycloak.env"
      ],
      "ports": [
        "127.0.0.1:${KEYCLOAK_PORT:-8081}:8080"
      ]
    },
    "openbao": {
      "env_file": [
        "${HAXUS_SERVICE_ENV_ROOT}/openbao.env"
      ],
      "ports": [
        "127.0.0.1:${OPENBAO_PORT:-8201}:8200"
      ]
    },
    "kusa": {
      "env_file": [
        "${HAXUS_SERVICE_ENV_ROOT}/kusa.env"
      ],
      "ports": [
        "127.0.0.1:${KUSA_PORT:-5679}:5678"
      ]
    },
    "compose-dashboard": {
      "env_file": [
        "${HAXUS_SERVICE_ENV_ROOT}/compose-dashboard.env"
      ],
      "ports": [
        "127.0.0.1:${DASHBOARD_PORT:-15889}:18888"
      ]
    }
  }
}
